__pycache__/
*.pyc
desktop.ini
Thumbs.db

# Returned schoolwork. The repo is public and serves GitHub Pages, so scans of
# graded tests — a child's name, handwriting and marks — must never be pushed.
# The analysis derived from them stays local too: what gets committed is the
# practice questions it produces, which look like any other content.
_returned/*
!_returned/README.md

# Wordly Wise and the weekly spelling lists are personal study use only — the
# CC BY-NC-SA books in _source/ may be redistributed, these may not. They live
# here so a later session can read them; they must not reach a public repo.
_source/spelling/
_source/vocabulary/

# Purchased material. Not Creative Commons, not ours to redistribute, and this
# repo is public — so nothing under _private/ is ever committed. The CC-licensed
# Core Knowledge books live in _source/ and are committed; these do not.
_private/
